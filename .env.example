FALKOR_HOST=127.0.0.1
FALKOR_PORT=6389
FALKOR_GRAPH=chronos_novapay
# Separate immutable reference seed; visitor sessions are graph copies.
CHRONOS_COMPANY_GRAPH=chronos_delhivery_reference_v1
FALKOR_PASSWORD=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# Primary investigator when configured; Gemini is the next fallback.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Optional last-resort free-model router (paid model IDs are rejected)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

# Best-effort total model-request budget across Groq, Gemini and free OpenRouter.
CHRONOS_AI_BUDGET_SECONDS=75
